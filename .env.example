# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
# Only this allowlisted user may connect or disconnect the shared Codex account.
# Defaults to the first TELEGRAM_ALLOWED_USER_IDS entry.
# TELEGRAM_OWNER_USER_ID=
# Point this to a self-hosted Telegram Bot API Server to accept files up to 2 GB.
# TELEGRAM_API_ROOT=http://127.0.0.1:8081

# Codex access
# Leave CODEX_API_KEY empty to use ChatGPT / ChatGPT Pro subscription auth.
# The owner can connect ChatGPT from Коди's Telegram settings.
CODEX_API_KEY=
CODEX_MODEL=
# Optional dedicated model for autonomous runs. Defaults to CODEX_MODEL.
# CODEX_AUTOMATION_MODEL=
# Lightweight background tasks such as reactions and dialog titles.
CODY_SPARK_MODEL=gpt-5.3-codex-spark
# Project avatar planning and rendering.
CODY_AVATAR_MODEL=gpt-5.6-terra

# Used for automation schedules and displayed dates.
CODY_TIMEZONE=Europe/Moscow
# Safety defaults for autonomous work. Self-hosters can override them.
AUTOMATION_MIN_INTERVAL_MINUTES=15
MAX_ACTIVE_AUTOMATIONS=20
MAX_PARALLEL_AUTOMATIONS=2

# Project boundary
# All project switching and Codex workspaces must stay inside this directory.
APPROVED_DIRECTORY=./workspaces
# Optional comma-separated allowlist for additional workspace roots.
# Keep APPROVED_DIRECTORY as the primary/default root.
# APPROVED_DIRECTORIES=./workspaces,./other-workspaces
CODEX_WORKSPACE=

# Files and media
# Defaults to 20 MB with the public API and 2 GB with TELEGRAM_API_ROOT.
# MAX_FILE_SIZE=2147483648
# Codex dictation uses the current ChatGPT login from ~/.codex/auth.json.
# On failure it falls back only to the local faster-whisper helper.
CODEX_DICTATION_TIMEOUT_MS=120000
# FASTER_WHISPER_PYTHON=python3
# FASTER_WHISPER_SCRIPT=./tools/faster-whisper-transcribe.py
FASTER_WHISPER_MODEL=medium
FASTER_WHISPER_LANGUAGE=auto
FASTER_WHISPER_COMPUTE_TYPE=int8
FASTER_WHISPER_THREADS=2
# FASTER_WHISPER_MODEL_DIR=~/.cache/cody-tgbot/faster-whisper

# Codex launch behavior
CODEX_SANDBOX_MODE=workspace-write
CODEX_APPROVAL_POLICY=never

# Task queue
MAX_PARALLEL_CODEX_TASKS=2
