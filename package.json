{
  "name": "cody-tgbot",
  "version": "0.1.0",
  "private": true,
  "description": "Personal Telegram-controlled Codex agent for a Linux server",
  "license": "MIT",
  "author": "Tema Tumanov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tumanov-git/cody-tgbot.git"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "telegram",
